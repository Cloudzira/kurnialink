rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'ajd9TeXs6zPMbvVzGu5QMpR9xcm2';
    }

    // Pengunjung hanya boleh menambah klik sebanyak 1
    function clickPlusOne() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks is int
        && request.resource.data.clicks == resource.data.get('clicks', 0) + 1;
    }

    match /biolink/public {
      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || clickPlusOne();
      }

      // Profil, banner, dll: semua orang boleh membaca, hanya admin yang menulis
      match /profile/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
