rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /biolink/public {

      // Link & folder: semua orang boleh membaca.
      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
        allow update: if request.auth != null
          // Pengunjung (tanpa login) HANYA boleh menambah klik sebanyak 1
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
              && request.resource.data.clicks == resource.data.clicks + 1);
      }

      // Profil, banner, dll: semua orang boleh membaca, hanya admin yang boleh menulis.
      match /profile/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
